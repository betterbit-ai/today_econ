# DIEM V2 feature flag. Keep v1 until the V2 dry-run and manual checklist pass.
PIPELINE_VERSION=v1

# Groq free-tier generation
GROQ_API_KEY=gsk_...
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.6-27b

# Rights-safe web image providers. Both are optional; Wikimedia and the
# no-photo typographic cover remain available as fallbacks.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Hugging Face Access Token (for FLUX.1-schnell image generation)
HF_TOKEN=hf_...

# Slack receives status changes only in V2 (no caption or media upload).
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0...

# Instagram Business Login (optional locally; required for auto publishing)
INSTAGRAM_ACCESS_TOKEN=IG...
INSTAGRAM_USER_ID=17841433257606150
INSTAGRAM_USERNAME=diem.magazine
INSTAGRAM_API_VERSION=v23.0
PUBLISH_INSTAGRAM=false
# Meta Content Publishing API cannot attach a Reel/link sticker to a Story.
# Keep automatic raw Story upload off and send a Slack prompt for native Reel sharing.
PUBLISH_INSTAGRAM_STORY=false
MANUAL_REEL_STORY_SHARE=true
# 32-byte base64 key used only by scheduled token rotation
INSTAGRAM_TOKEN_ENCRYPTION_KEY=

# GitHub temporary release asset hosting (required when publishing locally)
GITHUB_TOKEN=ghp_...
GITHUB_REPOSITORY=owner/repo

# News RSS URL (Default: Maeil Business News - Economy)
NEWS_RSS_URL=https://www.mk.co.kr/rss/30100041/

# Configuration
HISTORY_FILE=./history.json
PUBLICATIONS_ROOT=./data/publications
EDITORIAL_HISTORY_FILE=./data/editorial-history.json
MAX_HISTORY_DAYS=7

# Pollinations.ai API Key (Optional: for bypassing public IP rate limits)
POLLINATIONS_API_KEY=
