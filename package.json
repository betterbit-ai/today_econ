{
  "name": "today-economy",
  "version": "1.0.0",
  "description": "Automated Korean Economic News Summarizer and Instagram Card News Creator",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:v2": "node src/v2/index.js",
    "diem:plan": "node src/v2/index.js plan --force",
    "diem:prepare": "node src/v2/index.js prepare",
    "diem:publish": "node src/v2/index.js publish",
    "diem:retry": "node src/v2/index.js retry",
    "diem:brand": "node scripts/generate-brand-assets.js",
    "diem:audio": "node scripts/generate-diem-audio.js",
    "diem:similarity": "python3 scripts/validate-topic-similarity.py",
    "insights": "node src/collect-insights.js",
    "cleanup:assets": "node src/cleanup-assets.js",
    "check:instagram": "node src/check-instagram.js",
    "refresh:instagram": "node src/refresh-instagram-token.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@slack/web-api": "^7.8.0",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.5",
    "groq-sdk": "^0.15.0",
    "playwright": "^1.49.0",
    "rss-parser": "^3.13.0"
  }
}
