{
  "description": "Project-local Codex lifecycle hooks.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex-harness/scripts/post-edit-check.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking project guardrails"
          }
        ]
      }
    ]
  }
}
